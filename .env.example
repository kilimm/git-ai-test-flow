# Runtime
NODE_ENV=development
PORT=3000
DATA_DIR=./data
LOG_LEVEL=info

# Database
DATABASE_PATH=./data/app.db
CHECKPOINT_DB_PATH=./data/checkpoints/checkpoints.db

# Security (replace with locally generated values; never commit real secrets)
ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
ENCRYPTION_KEY_VERSION=1
SESSION_SECRET=replace-me

# Public URL used by reports and notifications
PUBLIC_BASE_URL=http://localhost:5173

# Comma-separated private hosts allowed as test environments (exact host or *.example.internal)
SSRF_ALLOWLIST=

# Runner concurrency / registry
RUNNER_CONCURRENCY=2
RUNNER_MODE=local
# RUNNER_NAME=runner-a

# OIDC callback base (default: PUBLIC_BASE_URL + /api/v1)
# SSO_CALLBACK_BASE_URL=https://gait.example.com/api/v1

# Artifact storage (local | s3)
ARTIFACT_STORAGE=local
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=gait-artifacts
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PATH_STYLE=true

# Worker queue (heartbeat must be less than lease)
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_MS=30000
WORKER_HEARTBEAT_MS=10000
