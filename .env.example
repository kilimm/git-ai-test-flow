# Runtime
NODE_ENV=development
PORT=3000
DATA_DIR=./data
LOG_LEVEL=info

# Database
DATABASE_PATH=./data/app.db
CHECKPOINT_DB_PATH=./data/checkpoints/checkpoints.db

# Security (replace with locally generated values; never commit real secrets)
ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
ENCRYPTION_KEY_VERSION=1
SESSION_SECRET=replace-me

# Public URL used by reports and notifications
PUBLIC_BASE_URL=http://localhost:5173

# Comma-separated private hosts allowed as test environments
SSRF_ALLOWLIST=

# Runner concurrency
RUNNER_CONCURRENCY=2

# Worker queue (heartbeat must be less than lease)
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_MS=30000
WORKER_HEARTBEAT_MS=10000
