# Runtime
NODE_ENV=development
PORT=3000
DATA_DIR=./data
LOG_LEVEL=info

# Database (PostgreSQL)
# 业务库与 LangGraph checkpoint 必须是两个不同的数据库。
DATABASE_URL=postgresql://gait:replace-me@localhost:5432/gait
CHECKPOINT_DATABASE_URL=postgresql://gait:replace-me@localhost:5432/gait_checkpoints

# docker compose 使用（PostgreSQL 容器与初始化）
POSTGRES_USER=gait
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=gait
# Compose 用 URL 编码后的密码拼接 DATABASE_URL，必须与 POSTGRES_PASSWORD 表示同一个密码；
# 含 @ : / ? # 等字符时请用 encodeURIComponent 生成：node -e "console.log(encodeURIComponent(process.argv[1]))" 'your-password'
POSTGRES_PASSWORD_URLENCODED=replace-me
# Compose 固定创建 gait_checkpoints 作为 checkpoint 库；非 Compose 部署直接配置 CHECKPOINT_DATABASE_URL。

# Security (replace with locally generated values; never commit real secrets)
ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
ENCRYPTION_KEY_VERSION=1
SESSION_SECRET=replace-me

# Public URL used by reports and notifications
PUBLIC_BASE_URL=http://localhost:5173

# Comma-separated private hosts allowed as test environments (exact host or *.example.internal)
SSRF_ALLOWLIST=

# Runner concurrency / registry
RUNNER_CONCURRENCY=2
RUNNER_MODE=local
# RUNNER_NAME=runner-a

# OIDC callback base (default: PUBLIC_BASE_URL + /api/v1)
# SSO_CALLBACK_BASE_URL=https://gait.example.com/api/v1

# Artifact storage (local | s3)
ARTIFACT_STORAGE=local
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=gait-artifacts
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PATH_STYLE=true

# Worker queue (heartbeat must be less than lease)
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_MS=30000
WORKER_HEARTBEAT_MS=10000
