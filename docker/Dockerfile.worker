# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable

WORKDIR /src
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
COPY apps ./apps
COPY packages ./packages
COPY tsconfig.json tsconfig.base.json tsconfig.package.json ./
RUN pnpm install --frozen-lockfile
RUN pnpm exec tsc -b apps/worker

# Playwright 官方镜像已包含 Chromium 及系统依赖；Worker 默认非 root 运行。
FROM mcr.microsoft.com/playwright:v1.65.1-noble AS runtime

ENV NODE_ENV=production
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN corepack enable && npm install -g corepack@latest >/dev/null 2>&1 || true

WORKDIR /app
COPY --from=build /src/package.json /src/pnpm-lock.yaml /src/pnpm-workspace.yaml .npmrc ./
COPY --from=build /src/apps ./apps
COPY --from=build /src/packages ./packages
RUN pnpm install --prod --frozen-lockfile --filter @gait/worker... \
  && mkdir -p /data && chown -R pwuser:pwuser /data /app

USER pwuser
ENV DATA_DIR=/data
ENV DATABASE_PATH=/data/app.db
ENV CHECKPOINT_DB_PATH=/data/checkpoints/checkpoints.db
CMD ["node", "apps/worker/dist/main.js"]
