# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable

WORKDIR /src
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
COPY apps ./apps
COPY packages ./packages
COPY tsconfig.json tsconfig.base.json tsconfig.package.json ./
RUN pnpm install --frozen-lockfile
RUN pnpm exec tsc -b apps/server

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable

WORKDIR /app
COPY --from=build /src/package.json /src/pnpm-lock.yaml /src/pnpm-workspace.yaml .npmrc ./
COPY --from=build /src/apps ./apps
COPY --from=build /src/packages ./packages
RUN pnpm install --prod --frozen-lockfile --filter @gait/server... \
  && mkdir -p /data && chown -R node:node /data /app

USER node
EXPOSE 3000
ENV DATA_DIR=/data
ENV DATABASE_PATH=/data/app.db
ENV CHECKPOINT_DB_PATH=/data/checkpoints/checkpoints.db
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/server/dist/main.js"]
