{
  "name": "git-ai-test-flow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @gait/web build",
    "check:deps": "depcruise apps packages --config .dependency-cruiser.cjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "audit": "pnpm audit --prod --audit-level high",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsc -b packages/db && node packages/db/dist/cli/migrate.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit && tsc -p tsconfig.scripts.json --noEmit && pnpm --filter @gait/web typecheck",
    "verify:workspace": "node scripts/verify-workspace.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.58.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.1.1",
    "dependency-cruiser": "^18.8.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "overrides": {
      "better-sqlite3": "13.2.0"
    }
  }
}
